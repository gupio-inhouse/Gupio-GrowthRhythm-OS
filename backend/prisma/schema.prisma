generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  COMPANY_ADMIN
  DEPARTMENT_HEAD
  MANAGER
  TEAM_MEMBER
  COACH_ADVISOR
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum Plan {
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockerType {
  APPROVAL
  CLIENT
  DEPENDENCY
  RESOURCE
  UNCLEAR_REQUIREMENT
  SYSTEM_ISSUE
  OTHER
}

enum StandupStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum StandupCardStatus {
  PENDING
  SUBMITTED
  UPDATED
}

enum ReviewType {
  TACTICAL
  STRATEGIC
  ONE_ON_ONE
  DEPARTMENT
}

enum MagicLinkPurpose {
  COMPANY_ONBOARDING
  DEPARTMENT_HEAD_INVITE
  MEMBER_INVITE
  DAILY_STANDUP
  PASSWORD_RESET
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  PUSH
  DASHBOARD
}

enum NotificationStatus {
  SCHEDULED
  SENT
  FAILED
  RETRIED
  DELIVERED
  OPENED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  INVITE
  REVOKE
}

enum DeptAccessType {
  FULL
  SPECIFIC
}

// ─── Core Entities ────────────────────────────────────────────────────────────

model Organization {
  id               String   @id @default(cuid())
  name             String
  industry         String
  employeeCount    Int?     @map("employee_count")
  plan             Plan     @default(STARTER)
  fiscalYearStart  Int      @default(4) @map("fiscal_year_start")
  preferredLanguage String  @default("en") @map("preferred_language")
  logoUrl          String?  @map("logo_url")
  isActive         Boolean  @default(true) @map("is_active")
  aiCreditsTotal   Int      @default(1000) @map("ai_credits_total")
  aiCreditsUsed    Int      @default(0) @map("ai_credits_used")
  quietHoursStart  Int?     @default(22) @map("quiet_hours_start")
  quietHoursEnd    Int?     @default(7) @map("quiet_hours_end")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users           User[]
  departments     Department[]
  teams           Team[]
  teamDocuments   TeamDocument[]
  tasks           Task[]
  standups        Standup[]
  reviews         Review[]
  magicLinks      MagicLink[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  industryTemplate IndustryTemplate?
  jobDescriptions JobDescription[]
  candidates      Candidate[]
  onboardingChecklists OnboardingChecklist[]
  appFeedback     AppFeedback[]
  learningModules     LearningModule[]
  learningEnrollments LearningEnrollment[]
  departmentGrants    UserDepartmentGrant[]

  @@map("organizations")
}

model User {
  id           String     @id @default(cuid())
  orgId        String     @map("org_id")
  email        String
  phone        String?
  name         String
  role         UserRole   @default(TEAM_MEMBER)
  departmentId String?    @map("department_id")
  managerId    String?    @map("manager_id")
  status       UserStatus @default(INVITED)
  avatarUrl    String?    @map("avatar_url")
  passwordHash String?    @map("password_hash")
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  mfaSecret         String?    @map("mfa_secret")
  notificationPrefs Json?      @map("notification_prefs")
  lastLoginAt       DateTime?  @map("last_login_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id])
  manager      User?         @relation("ManagerTeam", fields: [managerId], references: [id])
  directReports User[]       @relation("ManagerTeam")

  assignedTasks        Task[]             @relation("TaskAssignee")
  tasksAssigned        Task[]             @relation("TaskAssigner")
  tasksReviewed        Task[]             @relation("TaskReviewer")
  taskComments         TaskComment[]
  standupCards         StandupCard[]
  magicLinks           MagicLink[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  headOfDepartments    Department[]       @relation("DepartmentHead")
  managedTeams         Team[]             @relation("TeamManager")
  headedTeams          Team[]             @relation("TeamDeptHead")
  teamMemberships      TeamMember[]
  uploadedDocuments    TeamDocument[]     @relation("TeamDocUploader")
  interviewScorecards  InterviewScorecard[]
  onboardingChecklists OnboardingChecklist[]
  appFeedback          AppFeedback[]
  taskStatusHistories  TaskStatusHistory[] @relation("UserStatusHistories")
  createdModules       LearningModule[]    @relation("LearningModuleCreator")
  enrollments          LearningEnrollment[] @relation("UserEnrollments")
  lessonProgress       LessonProgress[]    @relation("UserLessonProgress")
  certificates         LearningCertificate[] @relation("UserCertificates")
  receivedGrant        UserDepartmentGrant? @relation("ReceivedGrant")
  issuedGrants         UserDepartmentGrant[] @relation("IssuedGrants")
  sopsCreated          DepartmentSop[]       @relation("SopCreatedBy")
  sopsUpdated          DepartmentSop[]       @relation("SopUpdatedBy")

  @@unique([orgId, email])
  @@map("users")
}

model Department {
  id               String  @id @default(cuid())
  orgId            String  @map("org_id")
  name             String
  slug             String
  headUserId       String? @map("head_user_id")
  parentDeptId     String? @map("parent_department_id")
  standupTime      String  @default("09:00") @map("standup_time")
  standupDuration  Int     @default(15) @map("standup_duration")
  standupMeetUrl   String? @map("standup_meet_url")
  isActive         Boolean @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  head         User?        @relation("DepartmentHead", fields: [headUserId], references: [id])
  parent       Department?  @relation("SubDepartments", fields: [parentDeptId], references: [id])
  subDepts     Department[] @relation("SubDepartments")

  users           User[]
  teams           Team[]
  tasks           Task[]
  standups        Standup[]
  jobDescriptions JobDescription[]
  appFeedback     AppFeedback[]
  learningModules LearningModule[]
  sops            DepartmentSop[]

  @@unique([orgId, slug])
  @@map("departments")
}

model UserDepartmentGrant {
  id              String         @id @default(cuid())
  orgId           String         @map("org_id")
  userId          String         @unique @map("user_id")
  grantedByUserId String         @map("granted_by_user_id")
  accessType      DeptAccessType @map("access_type")
  departmentIds   String[]       @map("department_ids")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation("ReceivedGrant", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User         @relation("IssuedGrants", fields: [grantedByUserId], references: [id])

  @@unique([orgId, userId])
  @@map("user_department_grants")
}

model Team {
  id                   String     @id @default(cuid())
  orgId                String     @map("org_id")
  departmentId         String     @map("department_id")
  managerUserId        String?    @map("manager_user_id")
  departmentHeadUserId String?    @map("department_head_user_id")
  name                 String
  slug                 String
  description          String?
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department     Department     @relation(fields: [departmentId], references: [id])
  manager        User?          @relation("TeamManager", fields: [managerUserId], references: [id])
  departmentHead User?          @relation("TeamDeptHead", fields: [departmentHeadUserId], references: [id])
  members        TeamMember[]
  documents      TeamDocument[]
  tasks          Task[]
  phases         ProjectPhase[]

  @@unique([orgId, slug])
  @@map("teams")
}

model TeamDocument {
  id           String   @id @default(cuid())
  teamId       String   @map("team_id")
  orgId        String   @map("org_id")
  name         String
  url          String
  fileType     String?  @map("file_type")
  size         Int?
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("TeamDocUploader", fields: [uploadedById], references: [id])

  @@map("team_documents")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}



model Task {
  id             String       @id @default(cuid())
  orgId          String       @map("org_id")
  teamId         String?      @map("team_id")
  departmentId   String?      @map("department_id")
  assigneeUserId String?      @map("assignee_user_id")
  assignedByUserId String?    @map("assigned_by_user_id")
  title          String
  description    String?
  expectedOutcome String?     @map("expected_outcome")
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  startDate      DateTime?    @map("start_date")
  dueDate        DateTime?    @map("due_date")
  completionSubmittedAt DateTime? @map("completion_submitted_at")
  completedAt    DateTime?    @map("completed_at")
  completionReviewedAt DateTime? @map("completion_reviewed_at")
  completionReviewedByUserId String? @map("completion_reviewed_by_user_id")
  blockerType    BlockerType? @map("blocker_type")
  blockerOwnerId String?      @map("blocker_owner_id")
  blockerExpectedResolution DateTime? @map("blocker_expected_resolution")
  blockerCount   Int          @default(0) @map("blocker_count")
  dependencyId   String?      @map("dependency_id")
  sourceType     String?      @map("source_type")
  recurrence     String?      @map("recurrence")
  phaseId        String?      @map("phase_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  assignedBy   User?        @relation("TaskAssigner", fields: [assignedByUserId], references: [id])
  completionReviewedBy User? @relation("TaskReviewer", fields: [completionReviewedByUserId], references: [id])
  dependency   Task?        @relation("TaskDependency", fields: [dependencyId], references: [id])
  dependents   Task[]       @relation("TaskDependency")
  phase        ProjectPhase? @relation(fields: [phaseId], references: [id])
  comments     TaskComment[]
  attachments  TaskAttachment[]
  statusHistories TaskStatusHistory[]

  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  name      String
  url       String
  type      String
  size      Int?
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

model Standup {
  id           String        @id @default(cuid())
  orgId        String        @map("org_id")
  departmentId String        @map("department_id")
  scheduledAt  DateTime      @map("scheduled_at")
  startedAt    DateTime?     @map("started_at")
  endedAt      DateTime?     @map("ended_at")
  status       StandupStatus @default(SCHEDULED)
  timerMinutes Int           @default(15) @map("timer_minutes")
  overrunMinutes Float?      @map("overrun_minutes")
  meetUrl      String?       @map("meet_url")
  aiDigestSent Boolean       @default(false) @map("ai_digest_sent")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department    @relation(fields: [departmentId], references: [id])
  cards      StandupCard[]

  @@map("standups")
}

model StandupCard {
  id                String           @id @default(cuid())
  standupId         String           @map("standup_id")
  userId            String           @map("user_id")
  yesterdaySummary  String?          @map("yesterday_summary")
  todayCommitments  String?          @map("today_commitments")
  blockers          String?
  status            StandupCardStatus @default(PENDING)
  spokenDurationSec Int?             @map("spoken_duration_sec")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  standup Standup @relation(fields: [standupId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([standupId, userId])
  @@map("standup_cards")
}

model Review {
  id          String     @id @default(cuid())
  orgId       String     @map("org_id")
  type        ReviewType
  departmentId String?   @map("department_id")
  scheduledAt DateTime   @map("scheduled_at")
  conductedAt DateTime?  @map("conducted_at")
  agenda      String?
  decisions   String?
  actionItems Json?      @map("action_items")
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model MagicLink {
  id         String           @id @default(cuid())
  orgId      String           @map("org_id")
  userId     String           @map("user_id")
  purpose    MagicLinkPurpose
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at")
  usedAt     DateTime?        @map("used_at")
  revokedAt  DateTime?        @map("revoked_at")
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@map("magic_links")
}

model Notification {
  id           String              @id @default(cuid())
  userId       String              @map("user_id")
  orgId        String              @map("org_id")
  channel      NotificationChannel
  type         String
  payload      Json
  scheduledFor DateTime?           @map("scheduled_for")
  sentAt       DateTime?           @map("sent_at")
  deliveredAt  DateTime?           @map("delivered_at")
  openedAt     DateTime?           @map("opened_at")
  status       NotificationStatus  @default(SCHEDULED)
  retryCount   Int                 @default(0) @map("retry_count")
  errorMessage String?             @map("error_message")
  createdAt    DateTime            @default(now()) @map("created_at")

  user User         @relation(fields: [userId], references: [id])
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(cuid())
  orgId      String      @map("org_id")
  userId     String      @map("user_id")
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction
  before     Json?
  after      Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model IndustryTemplate {
  id           String   @id @default(cuid())
  orgId        String   @unique @map("org_id")
  industry     String
  templateData Json     @map("template_data")
  appliedAt    DateTime @default(now()) @map("applied_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("industry_templates")
}

// ─── Hiring & Capability Planner (M15) ───────────────────────────────────────

enum HiringStage {
  OPEN
  SOURCING
  SCREENING
  INTERVIEWING
  OFFER
  HIRED
  REJECTED
  ON_HOLD
}

enum CandidateStatus {
  ACTIVE
  ARCHIVED
  HIRED
  REJECTED
}

model JobDescription {
  id           String    @id @default(cuid())
  orgId        String    @map("org_id")
  departmentId String?   @map("department_id")
  title        String
  description  String?
  requirements String?
  niceToHave   String?
  salaryMin    Int?      @map("salary_min")
  salaryMax    Int?      @map("salary_max")
  location     String?
  isRemote     Boolean   @default(false) @map("is_remote")
  stage        HiringStage @default(OPEN)
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department Department?   @relation(fields: [departmentId], references: [id])
  candidates Candidate[]

  @@map("job_descriptions")
}

model Candidate {
  id              String          @id @default(cuid())
  orgId           String          @map("org_id")
  jobId           String          @map("job_id")
  name            String
  email           String
  phone           String?
  resumeUrl       String?         @map("resume_url")
  linkedinUrl     String?         @map("linkedin_url")
  stage           HiringStage     @default(SOURCING)
  status          CandidateStatus @default(ACTIVE)
  notes           String?
  consentGiven    Boolean         @default(false) @map("consent_given")
  consentGivenAt  DateTime?       @map("consent_given_at")
  createdBy       String          @map("created_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  job          JobDescription      @relation(fields: [jobId], references: [id])
  scorecards   InterviewScorecard[]

  @@map("candidates")
}

model InterviewScorecard {
  id          String   @id @default(cuid())
  candidateId String   @map("candidate_id")
  interviewerId String @map("interviewer_id")
  round       String
  scores      Json
  overallRating Int?   @map("overall_rating")
  recommendation String?
  notes       String?
  conductedAt DateTime @default(now()) @map("conducted_at")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewer User      @relation(fields: [interviewerId], references: [id])

  @@map("interview_scorecards")
}

model OnboardingChecklist {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  userId      String   @map("user_id")
  title       String
  items       Json
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id])

  @@map("onboarding_checklists")
}

// ─── App Feedback ─────────────────────────────────────────────────────────────

enum FeedbackCategory {
  BUG
  FEATURE_REQUEST
  UI_UX
  PERFORMANCE
  OTHER
}

enum FeedbackStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IMPLEMENTED
  DISMISSED
}

model AppFeedback {
  id           String           @id @default(cuid())
  orgId        String           @map("org_id")
  userId       String           @map("user_id")
  departmentId String?          @map("department_id")
  title        String
  description  String
  category     FeedbackCategory @default(OTHER)
  status       FeedbackStatus   @default(OPEN)
  upvotes      Int              @default(0)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  votes      AppFeedbackVote[]

  @@map("app_feedback")
}

model AppFeedbackVote {
  id         String   @id @default(cuid())
  feedbackId String   @map("feedback_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  feedback AppFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@map("app_feedback_votes")
}

model TaskStatusHistory {
  id              String      @id @default(cuid())
  taskId          String      @map("task_id")
  fromStatus      TaskStatus? @map("from_status")
  toStatus        TaskStatus  @map("to_status")
  changedAt       DateTime    @default(now()) @map("changed_at")
  changedById     String      @map("changed_by_id")
  blockerType     BlockerType? @map("blocker_type")
  blockerDescription String?  @map("blocker_description")
  blockerExpectedResolution DateTime? @map("blocker_expected_resolution")
  suggestions     Json?       @map("suggestions")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy User @relation("UserStatusHistories", fields: [changedById], references: [id], onDelete: Cascade)

  @@map("task_status_histories")
}

// ─── Learning Module ──────────────────────────────────────────────────────────

enum LearningModuleType {
  ONBOARDING
  COMPLIANCE
  SKILLS
  PRODUCT
  PROCESS
  CERTIFICATION
  OTHER
}

enum LessonContentType {
  VIDEO
  PDF
  ARTICLE
  QUIZ
  EMBED
  CHECKPOINT
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  DROPPED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LearningModule {
  id            String             @id @default(cuid())
  orgId         String             @map("org_id")
  departmentId  String?            @map("department_id")
  title         String
  description   String?
  coverImageUrl String?            @map("cover_image_url")
  type          LearningModuleType @default(OTHER)
  isPublished   Boolean            @default(false) @map("is_published")
  isMandatory   Boolean            @default(false) @map("is_mandatory")
  passScore     Int                @default(70) @map("pass_score")
  durationDays  Int?               @map("duration_days")
  order         Int                @default(0)
  isActive      Boolean            @default(true) @map("is_active")
  createdById   String             @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  org          Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?          @relation(fields: [departmentId], references: [id])
  createdBy    User                 @relation("LearningModuleCreator", fields: [createdById], references: [id])
  phases       LearningPhase[]
  lessons      LearningLesson[]
  enrollments  LearningEnrollment[]
  certificates LearningCertificate[]

  @@map("learning_modules")
}

model LearningPhase {
  id          String   @id @default(cuid())
  moduleId    String   @map("module_id")
  title       String
  phaseNumber Int      @map("phase_number")
  color       String?
  dayStart    Int?     @map("day_start")
  dayEnd      Int?     @map("day_end")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  module  LearningModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons LearningLesson[]

  @@map("learning_phases")
}

model LearningLesson {
  id              String            @id @default(cuid())
  moduleId        String            @map("module_id")
  phaseId         String?           @map("phase_id")
  title           String
  description     String?
  contentType     LessonContentType @map("content_type")
  contentUrl      String?           @map("content_url")
  contentBody     String?           @map("content_body")
  notesUrl        String?           @map("notes_url")
  topics          Json?
  dayStart        Int?              @map("day_start")
  dayEnd          Int?              @map("day_end")
  checkpointItems Json?             @map("checkpoint_items")
  durationMins    Int?              @map("duration_mins")
  order           Int               @default(0)
  isRequired      Boolean           @default(true) @map("is_required")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  module   LearningModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  phase    LearningPhase?  @relation(fields: [phaseId], references: [id])
  quizzes  LearningQuiz[]
  progress LessonProgress[]

  @@map("learning_lessons")
}

model LearningQuiz {
  id            String   @id @default(cuid())
  lessonId      String   @map("lesson_id")
  question      String
  options       Json
  correctAnswer Int      @map("correct_answer")
  explanation   String?
  points        Int      @default(1)
  order         Int      @default(0)

  lesson LearningLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("learning_quizzes")
}

model LearningEnrollment {
  id          String           @id @default(cuid())
  orgId       String           @map("org_id")
  moduleId    String           @map("module_id")
  userId      String           @map("user_id")
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  dueDate     DateTime?        @map("due_date")
  startedAt   DateTime?        @map("started_at")
  completedAt DateTime?        @map("completed_at")
  score       Float?
  passed      Boolean?

  org         Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module      LearningModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User                 @relation("UserEnrollments", fields: [userId], references: [id])
  progress    LessonProgress[]
  certificate LearningCertificate?

  @@unique([moduleId, userId])
  @@map("learning_enrollments")
}

model LessonProgress {
  id            String               @id @default(cuid())
  enrollmentId  String               @map("enrollment_id")
  lessonId      String               @map("lesson_id")
  userId        String               @map("user_id")
  status         LessonProgressStatus @default(NOT_STARTED)
  startedAt      DateTime?            @map("started_at")
  completedAt    DateTime?            @map("completed_at")
  lastActivityAt DateTime?            @map("last_activity_at")
  timeSpentSec   Int                  @default(0) @map("time_spent_sec")
  videoPosition Int?                 @map("video_position")
  quizScore     Float?               @map("quiz_score")
  quizAttempts  Int                  @default(0) @map("quiz_attempts")
  quizAnswers   Json?                @map("quiz_answers")

  enrollment LearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     LearningLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User               @relation("UserLessonProgress", fields: [userId], references: [id])

  @@unique([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model DepartmentSop {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  departmentId String   @map("department_id")
  title        String
  content      String   @db.Text
  order        Int      @default(0)
  createdById  String   @map("created_by_id")
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("SopCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?      @relation("SopUpdatedBy", fields: [updatedById], references: [id])

  @@index([departmentId])
  @@index([orgId])
  @@map("department_sops")
}

model LearningCertificate {
  id             String   @id @default(cuid())
  enrollmentId   String   @unique @map("enrollment_id")
  userId         String   @map("user_id")
  moduleId       String   @map("module_id")
  issuedAt       DateTime @default(now()) @map("issued_at")
  certificateUrl String?  @map("certificate_url")

  enrollment LearningEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  user       User               @relation("UserCertificates", fields: [userId], references: [id])
  module     LearningModule     @relation(fields: [moduleId], references: [id])

  @@map("learning_certificates")
}

model ProjectPhase {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  name      String   // e.g. "Phase 1"
  dueDate   DateTime @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([teamId, name])
  @@map("project_phases")
}

