DATABASE_URL="postgresql://postgres:password@localhost:5432/growthrhythm"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
REDIS_URL="redis://localhost:6379"

# Email — Microsoft 365 via OAuth2 client-credentials (app-only SMTP AUTH).
# Requires an Azure app registration with the SMTP.SendAsApp application
# permission (admin-consented) and "Authenticated SMTP" enabled on SMTP_USER's
# mailbox. See backend/src/services/email.service.ts for the full auth flow
# and the plain SMTP_PASS fallback for non-Microsoft providers.
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="GrowthRhythm OS"
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_SCOPE="https://outlook.office365.com/.default"

SENDGRID_API_KEY=""
WHATSAPP_API_KEY=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
