pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        // Keep only last 20 builds to save disk space
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // Prevent multiple builds of the same pipeline running simultaneously
        disableConcurrentBuilds()
    }

    triggers {
        // H spreads Jenkins load — effectively polls every 2 minutes
        pollSCM('H/2 * * * *')
    }

    environment {
        PNPM_HOME          = "${HOME}/.pnpm-global"
        PATH               = "${PNPM_HOME}/bin:/opt/homebrew/opt/openjdk@21/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

        // AWS & S3
        AWS_REGION         = "ap-south-1"
        S3_BUCKET          = "gupio-task-manager"
        CLOUDFRONT_DIST_ID = "E33CPU4Q6V79J6"

        // Path prefix this pipeline cares about
        WATCH_PATH         = "frontend/"
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    def rawBranch = env.BRANCH_NAME ?: env.GIT_BRANCH
                    if (!rawBranch && scm && scm.branches && !scm.branches.isEmpty()) {
                        rawBranch = scm.branches[0].name
                    }
                    if (!rawBranch) {
                        error("No branch specified! Please ensure the branch is configured in Jenkins.")
                    }
                    env.TARGET_BRANCH = rawBranch.replace('origin/', '').replace('*/', '')
                }
                echo "🚚 Checking out branch: ${env.TARGET_BRANCH}..."

                retry(3) {
                    sh '''
                    set -eux

                    BRANCH="$TARGET_BRANCH"
                    REPO_URL="git@github.com:gupio-inhouse/Gupio-GrowthRhythm-OS.git"

                    export GIT_SSH_COMMAND="ssh -4 -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -o TCPKeepAlive=yes"

                    if [ ! -d .git ]; then
                      git init .
                    fi

                    if git remote get-url origin > /dev/null 2>&1; then
                      git remote set-url origin "$REPO_URL"
                    else
                      git remote add origin "$REPO_URL"
                    fi

                    # depth 2 required so we can diff HEAD~1 vs HEAD
                    git fetch --depth 2 origin "refs/heads/$BRANCH"
                    # Discard any generated/leftover files before checkout
                    git reset --hard HEAD 2>/dev/null || true
                    git clean -ffd
                    git checkout -fB "$BRANCH" FETCH_HEAD
                    '''
                }

                sh '''
                echo "📌 Branch : $(git rev-parse --abbrev-ref HEAD)"
                echo "📌 Commit : $(git rev-parse HEAD)"
                git log -1 --oneline
                '''
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    // Get files changed in this commit vs its parent
                    def changedFiles = sh(
                        script: '''
                            if git rev-parse HEAD~1 > /dev/null 2>&1; then
                                git diff --name-only HEAD~1 HEAD
                            else
                                # First commit — treat everything as changed
                                git show --name-only --format="" HEAD
                            fi
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "📂 Changed files in this commit:\n${changedFiles}"

                    // Trigger full run if frontend/ OR the frontend Jenkinsfile itself changed
                    def lines = changedFiles ? changedFiles.split('\n') : []
                    def relevant = lines.any { f ->
                        f.startsWith('frontend/') && !f.startsWith('frontend/.npm-cache')
                    }

                    if (relevant) {
                        env.FRONTEND_CHANGED = 'true'
                        currentBuild.description = "🚀 frontend/ changes — deploying"
                        echo "✅ Relevant changes detected — pipeline will run."
                    } else {
                        env.FRONTEND_CHANGED = 'false'
                        currentBuild.description = "⏭️ No frontend changes — skipped"
                        echo "⏭️ No frontend changes detected — all build stages will be skipped."
                    }
                }
            }
        }

        stage('Install Dependencies') {
            when {
                expression { env.FRONTEND_CHANGED == 'true' }
            }
            steps {
                sh '''
                set -eux
                echo "📦 Installing frontend dependencies..."
                cd frontend
                if ! command -v pnpm &> /dev/null; then
                  echo "pnpm not found, installing..."
                  npm install -g pnpm --prefix "${PNPM_HOME}"
                fi
                pnpm install --frozen-lockfile
                '''
            }
        }

        stage('Build Frontend') {
            when {
                expression { env.FRONTEND_CHANGED == 'true' }
            }
            steps {
                sh '''
                set -eux
                echo "🏗️ Building frontend..."
                cd frontend
                pnpm run build
                echo "✅ Build complete. Contents of dist/:"
                ls -lh dist/
                '''
            }
        }

        stage('Deploy to S3') {
            when {
                expression { env.FRONTEND_CHANGED == 'true' }
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh '''
                    set -eux

                    echo "🗑️ Removing old files from S3 bucket: $S3_BUCKET..."
                    aws s3 rm s3://$S3_BUCKET --recursive --region $AWS_REGION

                    echo "🚀 Uploading new build to S3..."
                    aws s3 sync frontend/dist/ s3://$S3_BUCKET \
                        --region $AWS_REGION \
                        --delete \
                        --cache-control "public, max-age=31536000, immutable" \
                        --exclude "index.html"

                    echo "📄 Uploading index.html with no-cache headers..."
                    aws s3 cp frontend/dist/index.html s3://$S3_BUCKET/index.html \
                        --region $AWS_REGION \
                        --cache-control "no-cache, no-store, must-revalidate" \
                        --content-type "text/html"

                    echo "✅ S3 upload complete!"
                    '''
                }
            }
        }

        stage('Invalidate CloudFront') {
            when {
                expression { env.FRONTEND_CHANGED == 'true' }
            }
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    sh '''
                    set -eux

                    echo "🌐 Creating CloudFront invalidation for distribution: $CLOUDFRONT_DIST_ID..."
                    INVALIDATION_ID=$(aws cloudfront create-invalidation \
                        --distribution-id $CLOUDFRONT_DIST_ID \
                        --paths "/*" \
                        --query "Invalidation.Id" \
                        --output text)

                    echo "======================================"
                    echo "✅ CloudFront invalidation created!"
                    echo "   Invalidation ID: $INVALIDATION_ID"
                    echo "   Distribution:    $CLOUDFRONT_DIST_ID"
                    echo "======================================"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                // Mark as NOT_BUILT (grey) when skipped — keeps build history clean
                if (env.FRONTEND_CHANGED == 'false') {
                    currentBuild.result = 'NOT_BUILT'
                }
            }
            echo "📦 Frontend pipeline finished. Result: ${currentBuild.result ?: 'SUCCESS'}"
        }
        success {
            script {
                if (env.FRONTEND_CHANGED == 'true') {
                    echo "✅ Frontend deployed successfully to S3: ${env.S3_BUCKET}"
                }
            }
        }
        failure {
            echo '❌ Frontend pipeline failed! Check the logs above.'
        }
    }
}
